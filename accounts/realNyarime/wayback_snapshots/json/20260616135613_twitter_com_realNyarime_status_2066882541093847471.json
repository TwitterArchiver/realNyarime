      {
        "article": {},
        "attachments": {},
        "author_id": "1242074475400548352",
        "conversation_id": "2066880143889748186",
        "created_at": "2026-06-16T13:46:41.000Z",
        "edit_controls": {
          "editable_until": "2026-06-16T14:46:41.000Z",
          "edits_remaining": 5,
